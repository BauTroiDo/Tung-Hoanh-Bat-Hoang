+import unittest
+from unittest.mock import patch
+import native_session as session
+from native_gs_dispatch import NativeGsDispatch
+
+class TrafficTests(unittest.TestCase):
+    def test_sustained_session_exceeds_old_totals(self):
+        b=session.NativeTrafficBudget(0)
+        for second in range(600):
+            for unused in range(60):
+                b.charge(1024,frames=1,now=second)
+            b.check_idle(second)
+        self.assertGreater(600*60,4096)
+        self.assertGreater(600*60*1024,8*1024*1024)
+
+    def test_frame_burst_still_rejected(self):
+        b=session.NativeTrafficBudget(0)
+        b.charge(4096,frames=4096,now=0)
+        with self.assertRaisesRegex(ValueError,'rate limit'):
+            b.charge(1,frames=1,now=0)
+
+    def test_byte_burst_still_rejected(self):
+        b=session.NativeTrafficBudget(0)
+        b.charge(8*1024*1024,now=0)
+        with self.assertRaisesRegex(ValueError,'rate limit'):
+            b.charge(1,now=0)
+
+    def test_window_resets_but_idle_does_not(self):
+        b=session.NativeTrafficBudget(0)
+        b.charge(8*1024*1024,frames=4096,now=0)
+        b.charge(8*1024*1024,frames=4096,now=10)
+        b.check_idle(99)
+        with self.assertRaisesRegex(TimeoutError,'idle'):
+            b.check_idle(100)
+
+    def test_traffic_refreshes_idle(self):
+        b=session.NativeTrafficBudget(0)
+        b.charge(1,now=80)
+        b.check_idle(169)
+        with self.assertRaises(TimeoutError):b.check_idle(170)
+
+    def test_negative_traffic_rejected(self):
+        b=session.NativeTrafficBudget(0)
+        with self.assertRaises(ValueError):b.charge(-1,now=1)
+        with self.assertRaises(ValueError):b.charge(1,frames=-1,now=1)
+
+    def test_controlled_dispatch_has_no_fixed_lifetime(self):
+        dispatcher=NativeGsDispatch.__new__(NativeGsDispatch)
+        dispatcher.enabled=True
+        dispatcher.permits=object()
+        with patch('native_session.run_native_session',return_value='ok') as run:
+            self.assertEqual(dispatcher.serve(object(),'127.0.0.1',b'wire'),'ok')
+            self.assertIsNone(run.call_args.kwargs['max_seconds'])
+
+if __name__=='__main__':unittest.main()
