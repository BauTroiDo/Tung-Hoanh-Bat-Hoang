+def legacy_to_native_mps(x, y):
+    # GS: 512x1024 per region. Native4016: 1024x1024 per region.
+    x, y = _coord(x), _coord(y)
+    return _coord(x * 2), y
+
+
+def native_to_legacy_mps(x, y):
+    # Odd native X represents half a legacy unit; quantize toward lower X.
+    return _coord(x) // 2, _coord(y)
+
+
+def authoritative_move_target(legacy, expected_entity):
+    if (not isinstance(legacy, bytes) or len(legacy) != 13
+            or legacy[0] not in (85, 86)):
+        raise ValueError('Invalid authoritative move target')
+    entity, x, y = struct.unpack_from('<Iii', legacy, 1)
+    if type(expected_entity) is not int or not 1 <= expected_entity <= 0xffffffff or entity != expected_entity:
+        raise ValueError('Move target belongs to another entity')
+    nx, ny = legacy_to_native_mps(x, y)
+    return struct.pack('<BIii', 99 if legacy[0] == 85 else 79, entity, nx, ny)
+
+
