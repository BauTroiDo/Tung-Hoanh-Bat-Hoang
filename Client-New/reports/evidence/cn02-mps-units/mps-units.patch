+"""Coordinate contract: GS region512x1024, native4016 region1024x1024."""
+import struct,unittest
+from pathlib import Path
+import native_movement as move
+from native_initial_packets import convert_initial
+from test_native_map_region import fixture
+MAP=Path(__file__).with_name('M1-original-maplist.ini').read_bytes()
+
+def position(x=52032,y=101696,ox=0,oy=0,entity=41234):
+    return struct.pack('<BIiiiiI',206,entity,x,y,ox,oy,0)
+
+class MpsUnitTests(unittest.TestCase):
+    def test_initial_region_preserves_gs_region_not_raw_mps(self):
+        value=convert_initial(fixture(),MAP)
+        self.assertEqual(struct.unpack_from('<I',value.world,5)[0],0x00630065)
+        self.assertEqual(value.position,(52032,101696))
+    def test_initial_actor_uses_native_units(self):
+        value=convert_initial(fixture(),MAP)
+        self.assertEqual(struct.unpack_from('<ii',value.actor,53),(104064,101696))
+    def test_walk_inverse_before_range_check(self):
+        wire=struct.pack('<Bii',85,104080,101700)
+        self.assertEqual(move.client_movement(wire,53,(52032,101696)),struct.pack('<Bii',75,52040,101700))
+    def test_run_odd_x_quantizes_at_half_legacy_unit(self):
+        wire=struct.pack('<Bii',117,104081,101700)
+        self.assertEqual(move.client_movement(wire,53,(52032,101696)),struct.pack('<Biii',76,52040,101700,53))
+    def test_outbound_position_scales_x_only(self):
+        update=move.authoritative_position(position(),41234)
+        self.assertEqual(struct.unpack('<BIIIHH',update.packet),(120,41234,104064,101696,0,0))
+        self.assertEqual(update.position,(52032,101696))
+    def test_fractional_carry_and_cell_remainder(self):
+        update=move.authoritative_position(position(52049,101696,17920,2048),41234)
+        self.assertEqual(struct.unpack('<BIIIHH',update.packet),(120,41234,104099,101696,3072,2048))
+    def test_scaled_position_overflow_rejected(self):
+        with self.assertRaises(ValueError):
+            move.authoritative_position(position(0x40000000,101696),41234)
+    def test_inverse_does_not_expand_legacy_move_range(self):
+        with self.assertRaises(ValueError):
+            move.client_movement(struct.pack('<Bii',85,2*(52032+4097),101696),53,(52032,101696))
+    def test_negative_native_destination_rejected(self):
+        with self.assertRaises(ValueError):
+            move.client_movement(struct.pack('<Bii',85,-1,101696),53,(52032,101696))
+    def test_walk_target_echo_uses_native_units(self):
+        old=struct.pack('<BIii',85,41234,52040,101700)
+        self.assertEqual(move.authoritative_move_target(old,41234),struct.pack('<BIii',99,41234,104080,101700))
+    def test_run_target_identity_is_not_relabelled(self):
+        with self.assertRaises(ValueError):
+            move.authoritative_move_target(struct.pack('<BIii',86,999,52040,101700),41234)
+    def test_target_packet_size_must_match(self):
+        with self.assertRaises(ValueError):
+            move.authoritative_move_target(b'\x55'+b'\0'*8,41234)
+
+if __name__=='__main__':unittest.main(verbosity=2)
