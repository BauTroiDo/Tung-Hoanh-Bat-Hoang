/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_MAIN                ICON                    "Sword3PaySys.ico"
IDI_SMALL               ICON                    "Sword3PaySys2.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_S3PAYSYS MENU
BEGIN
    POPUP "&管理"
    BEGIN
        MENUITEM "&清理所有链接消息日志",                 IDM_CLEARLOG
        MENUITEM "&显示所有网关链接信息",                 IDM_SHOWINFO
        MENUITEM "解锁所有网络连接(谨慎操作)",              ID_FREE_ALL_NET
        MENUITEM "释放所有DB连接(谨慎操作)",              ID_FREE_ALLDB
        MENUITEM "获取所有DB连接的信息",                 ID_GET_AJJ_DBINFO
        MENUITEM "&退出",                         IDM_EXIT
    END
    POPUP "&帮助"
    BEGIN
        MENUITEM "&关于...",                      IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_S3PAYSYS ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG 22, 17, 230, 75
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System"
BEGIN
    ICON            IDI_MAIN,2,14,9,16,16
    LTEXT           "JXOnline Pay System Version 1.0",-1,49,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2003",-1,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
END


